# Example environment for the Ticket and Asset Management System.
# Copy to `.env` (repo root, git-ignored) and fill in real values.
# Every variable below is read by backend/config/settings.py; nothing else
# is supported. NEVER commit real secrets. There are intentionally no
# frontend (Vite) variables: the React app uses no VITE_* configuration.
#
# Generate a secret key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django core ---
# Long random string. REQUIRED in production; dev falls back to a committed key.
SECRET_KEY=change-me-in-production

# --- Email (provider-agnostic SMTP; dev default is the console backend) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
# Leave unset/empty unless your SMTP provider needs authentication.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com

# --- Public URLs (verification/reset links, ticket links in mail) ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# --- Attachment storage (local dev needs nothing) ---
# Set STORAGE_BACKEND=s3 plus django-storages + boto3 in production only.
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Only for S3-compatible providers (MinIO etc.); leave empty for real AWS.
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=auto
AWS_QUERYSTRING_EXPIRE=3600

# --- Attachment policy ---
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,log,docx,xlsx
ATTACHMENT_MAX_SIZE_MB=10
