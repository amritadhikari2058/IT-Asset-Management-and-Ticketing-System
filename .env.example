# Example environment for the Ticket and Asset Management System.
# Copy to `.env` (repo root, git-ignored) and fill in real values.
# Every variable below is read by backend/config/settings.py; nothing else
# is supported. NEVER commit real secrets. There are intentionally no
# frontend (Vite) variables: the React app uses no VITE_* configuration.
#
# Generate a secret key, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Django core ---
# Long random string. REQUIRED in production; dev falls back to a committed key.
SECRET_KEY=change-me-in-production
# Local default is true; production MUST set DEBUG=false. Starting with
# DEBUG=false and the default SECRET_KEY aborts with a clear error.
DEBUG=true
# Comma-separated production hostnames, e.g. ALLOWED_HOSTS=tickets.example.com.
# Empty keeps local `runserver` behavior.
ALLOWED_HOSTS=
# Comma-separated frontend origins (CORS). Defaults cover local Vite dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only needed for cross-origin session-auth cookie use; empty by default.
CSRF_TRUSTED_ORIGINS=

# --- Email (provider-agnostic SMTP; dev default is the console backend) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
# Leave unset/empty unless your SMTP provider needs authentication.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com

# --- Public URLs (verification/reset links, ticket links in mail) ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# --- Attachment storage (local dev needs nothing) ---
# Set STORAGE_BACKEND=s3 plus django-storages + boto3 in production only.
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Only for S3-compatible providers (MinIO etc.); leave empty for real AWS.
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=auto
AWS_QUERYSTRING_EXPIRE=3600

# --- Attachment policy ---
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,log,docx,xlsx
ATTACHMENT_MAX_SIZE_MB=10

# --- Email intake (organizational support mailbox via IMAP) ---
# Master switch for the inbound polling task.
INBOUND_MAILBOX_ENABLED=true
INBOUND_MAILBOX_HOST=
INBOUND_MAILBOX_PORT=993
INBOUND_MAILBOX_USER=
INBOUND_MAILBOX_PASSWORD=
INBOUND_MAILBOX_USE_TLS=true
INBOUND_MAILBOX_NAME=INBOX
INBOUND_SUPPORT_MAILBOX=support@example.com
INBOUND_ALLOWED_SENDER_DOMAINS=
INBOUND_MAILBOX_POLL_SECONDS=60

# --- Outbound email dedup window (seconds) ---
EMAIL_DEDUP_TTL_SECONDS=3600

# --- Background processing (Celery + Redis) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=60
CELERY_TASK_TIME_LIMIT=300
CELERY_CONCURRENCY=4
# Optional Redis-backed cache for multi-worker deployments (email dedup).
# CACHE_LOCATION=redis://localhost:6379/1
